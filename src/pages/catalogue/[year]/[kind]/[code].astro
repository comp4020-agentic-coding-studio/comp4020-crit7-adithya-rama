---
import Layout from "../../../../layouts/Layout.astro";
import {item,programRules,rules} from "../../../../lib/catalogue";
const {year,kind,code}=Astro.params;
const c=item(kind||"",code||"",Number(year));if(!c)return Astro.redirect("/explore");
const p=kind==="program"?programRules(c.code,c.year):undefined;
const sp=kind==="specialisation"?rules.programs.find(p=>p.year===c.year)?.specialisations.find(s=>s.code===c.code):undefined;
const cr=rules.courses.find(r=>r.code===c.code&&r.year===c.year);
---
<Layout title={c.name}>
<a class="breadcrumb" href={"/explore?year="+year+"&kind="+kind}>← Back to the catalogue</a>
<div class="detail-heading"><p class="eyebrow">{c.kind} · {c.code} · {c.year}</p><h1>{c.name}</h1><div class="chips"><span class="small-pill">{c.career}</span>{c.units&&<span class="small-pill">{c.units} units</span>}{c.mode&&<span class="small-pill">{c.mode}</span>}{p&&<span class="status met">Degree checking available</span>}</div></div>
<div class="detail-grid"><section class="panel"><h2>{kind==="course"?"About this course":"Study requirements"}</h2>
{kind==="course"?<><h3>Published offerings · {year}</h3><p>{c.sessions||"Offering information is not confirmed in this snapshot."}</p>{Number(year)>new Date().getFullYear()&&<p class="notice">Future offerings are indicative and may change.</p>}<h3>Requisites and incompatibilities</h3><p class="source-text">{cr?.requisiteText||"This course's eligibility rules have not been reviewed. Check the official course page."}</p><a class="button primary" href="/plan">Find where it fits in my plan →</a></>:p?<><p>96 units, with the rules that apply to your {year} commencement.</p><ul class="requirement-list">{p.buckets.map(b=><li><span>{b.name}</span><strong>{b.min===b.max?b.min:b.min===0?"Up to "+b.max:"At least "+b.min} units</strong></li>)}<li><span>One specialisation</span><strong>24 units</strong></li><li><span>8000-level COMP minimum</span><strong>24 units</strong></li></ul><h3>Choose your specialisation</h3><div class="specialisation-links">{p.specialisations.map(s=><a href={"/catalogue/"+year+"/specialisation/"+s.code}>{s.name} ↗</a>)}</div><a class="button primary" href={"/plan?new=1&program="+c.code+"&cohort="+year}>Start my plan →</a></>:sp?<><p>This reviewed specialisation requires 24 units, including {sp.level8Min} units at 8000 level.</p><ul class="requirement-list">{sp.buckets.map(b=><li><span>{b.name}<small>{b.codes?.join(", ")}</small></span><strong>{b.min===b.max?b.min:b.min===0?"Up to "+b.max:"At least "+b.min} units</strong></li>)}</ul><a class="button primary" href={"/plan?new=1&program=7706XMCOMP&cohort="+year}>Start my MCOMP plan →</a></>:<><p>Browse the official requirements, then build a saved manual plan. Automatic degree checking is not available for this {kind}.</p><a class="button primary" href={"/plan?new=1&program="+(kind==="program"?c.code:"")+"&cohort="+year}>Start a manual plan →</a></>}
</section><aside class="panel source-panel"><p class="eyebrow">SOURCE OF TRUTH</p><h2>Check the original.</h2><p>This entry is from ANU's public {year} catalogue. Your saved plan always keeps its own commencement-year rules.</p><a class="text-link" href={c.url} target="_blank" rel="noreferrer">Open official ANU page ↗</a><hr/><p class="fine">Snapshot captured September 2026. Public course information is separate from your ANUHub enrolment record.</p></aside></div>
</Layout>