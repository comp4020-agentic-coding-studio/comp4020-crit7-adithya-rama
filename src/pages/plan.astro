---
import Layout from "../layouts/Layout.astro";
import CoursePicker from "../components/CoursePicker.astro";
import {currentUser} from "../lib/auth";
import {listPlans,getPlan,records} from "../lib/store";
import {catalogue,programRules,course,courseUnits,item,RELEASE} from "../lib/catalogue";
import {evaluate,assess,planIssues} from "../lib/engine";
import {SESSIONS,semesterLabel,period,type Plan} from "../lib/types";
const user=currentUser(Astro.cookies),all=user?listPlans(user.id):[];
let p:Plan|undefined;
const id=Astro.url.searchParams.get("id")||all[0]?.id;
if(user&&id&&!Astro.url.searchParams.has("new")){try{p=getPlan(user.id,id);}catch{Astro.response.status=404;}}
const rs=user?records(user.id):[],completed=p?evaluate(p,rs):undefined,projected=p?evaluate(p,rs,true):undefined;
const rule=p?programRules(p.program,p.cohort,p.release):undefined;
const chosen=rule?.specialisations.find(s=>s.code===p?.specialisation);
const year=Number(Astro.url.searchParams.get("year")||2027),session=Astro.url.searchParams.get("session")||"First Semester",q=Astro.url.searchParams.get("q")||"";
const needed=new Set([...(rule?.buckets.flatMap(b=>b.codes||[])||[]),...(chosen?.buckets.flatMap(b=>b.codes||[])||[])]);
let candidates=p?catalogue.filter(c=>c.kind==="course"&&c.year===year&&(q?(c.code+" "+c.name).toLowerCase().includes(q.toLowerCase()):c.sessions.includes(session)&&(!rule||c.career==="Postgraduate"))&&!p!.selections.some(s=>s.code===c.code&&s.year===year&&s.session===session)):[];
candidates.sort((a,b)=>(needed.has(a.code)?0:a.code.startsWith("COMP")?1:2)-(needed.has(b.code)?0:b.code.startsWith("COMP")?1:2)||a.code.localeCompare(b.code));
const suggestions=p?candidates.slice(0,60).map(c=>({c,a:assess(p!,rs,{id:"candidate:"+c.code,code:c.code,units:courseUnits(c),year,session},projected)})).sort((a,b)=>a.a.rank-b.a.rank||a.c.code.localeCompare(b.c.code)).slice(0,12):[];
const periods=p?[...new Set([...p.selections.map(s=>s.year+"|"+s.session),year+"|"+session])].sort((a,b)=>{const [y,s]=a.split("|"),[y2,s2]=b.split("|");return period(Number(y),s)-period(Number(y2),s2);}):[];
const issues=p?planIssues(p,rs):[];
const newYear=Number(Astro.url.searchParams.get("cohort")||0);
const programOptions=[...new Map(catalogue.filter(c=>c.kind==="program").map(c=>[c.code,c])).values()].sort((a,b)=>a.code==="7706XMCOMP"?-1:b.code==="7706XMCOMP"?1:a.name.localeCompare(b.name));
---
<Layout title={p?p.name:"My study plan"} active="My plan" wide>
{!p?<><div class="page-heading"><p class="eyebrow">START WITH YOUR CONTEXT</p><h1>Make room for<br/><em>what comes next.</em></h1><p>A semester plan that follows your degree, and your progress.</p></div>
{!user?<div class="empty-state"><h2>Your degree deserves a plan.</h2><p>Try the fictional example now, or sign in to start your own.</p><form method="post" action="/api/action"><input type="hidden" name="action" value="demo"/><button class="button primary">Explore an example plan ↗</button></form><a class="text-link" href="/account">Sign in or create an account →</a></div>:<section class="panel setup-panel"><h2>Set up your degree plan</h2><form class="form-stack" method="post" action="/api/action"><input type="hidden" name="action" value="create-plan"/><div><label for="name">Plan name</label><input id="name" name="name" maxlength="80" required value="My degree plan"/></div><div><label for="program">Your program</label><select id="program" name="program" required><option value="">Choose your degree</option>{programOptions.map(c=><option value={c.code} selected={Astro.url.searchParams.get("program")===c.code}>{c.name} ({c.code})</option>)}</select></div><div><label for="cohort">When did you commence this program?</label><select name="cohort" id="cohort" required><option value="">Select commencement year</option>{[2025,2026,2027].map(y=><option selected={newYear===y}>{y}</option>)}</select><span class="field-help">This fixes the degree rules your plan uses. It is separate from the semester you will study.</span></div><p class="note">Automatic checking supports Master of Computing, 2025 and 2026. Other programs have a saved manual planner.</p><button class="button primary">Create my plan →</button></form></section>}</>:<>
<div class="plan-topline"><a class="breadcrumb" href="/plan?new=1">＋ New plan</a><div class="plan-switcher">{all.map(a=><a href={"/plan?id="+a.id} class:list={[{selected:a.id===p!.id}]}>{a.name}</a>)}</div><a class="text-link" href={"/review?id="+p.id}>Print / review ↗</a></div>
<div class="page-heading heading-row plan-title"><div><p class="eyebrow">YOUR STUDY, WITH DIRECTION</p><h1>Your plan, taking shape.</h1><p>{item("program",p.program,p.cohort)?.name||p.program}<span class="dot-separator">·</span>{chosen?.name||"Specialisation not selected"}</p></div><span class="cohort-badge"><span>YOUR DEGREE RULES</span><strong>{p.cohort}</strong><span>Commencement year</span></span></div>
{user?.username.startsWith("demo_")&&<div class="demo-banner"><span><strong>Meet your example student.</strong> These records are fictional. Make changes and see what happens.</span><a href="/account?mode=register">Keep this plan ↗</a></div>}
{Astro.url.searchParams.get("change")&&<p class="notice success" role="status">{Astro.url.searchParams.get("change")}</p>}
<div class="planner-layout"><aside class="progress-sidebar"><section class="progress-panel"><p class="eyebrow">THE BIG PICTURE</p><h2>Every unit counts.</h2>{completed!.supported?<><div class="degree-ring" style={"--progress:"+Math.min(100,completed!.allocated/96*100)+"%"}><div><strong>{completed!.allocated}<span>/96</span></strong><small>units counted</small></div></div><div class="progress-stats"><div><span class="legend-dot complete"></span><span>Completed & credited</span><strong>{completed!.allocated}</strong></div><div><span class="legend-dot planned"></span><span>Additional projected</span><strong>{Math.max(0,projected!.allocated-completed!.allocated)}</strong></div><div><span class="legend-dot remaining"></span><span>Still to complete</span><strong>{Math.max(0,96-completed!.allocated)}</strong></div></div><p class="fine">Projected units depend on passing planned courses. They are not completed study.</p></>:<><strong class="big-number">{completed!.earned}</strong><p>Reported earned units</p><p class="notice">Automatic degree checking is not available for this program.</p></>}
<a class="button secondary full" href={"/study?id="+p.id}>Manage my study record ↗</a></section>
{completed!.supported&&<section class="requirements-panel"><div class="section-heading"><h2>What remains</h2><span class="small-pill">{completed!.requirements.filter(r=>r.remaining>0).length}</span></div><p class="fine">Based on completed study and credit.</p>{completed!.requirements.filter(r=>r.min>0).map(r=><details class="requirement-item"><summary><span class:list={["requirement-check",{done:r.remaining===0}]}>{r.remaining===0?"✓":"○"}</span><span>{r.name}</span><small>{r.units}/{r.min}</small></summary><div><p>{r.remaining?r.remaining+" units still needed.":"Reviewed requirement satisfied."}</p><p>{r.courses.join(", ")||"No courses allocated yet."}</p><a href={r.source} target="_blank" rel="noreferrer">Why this is required ↗</a></div></details>)}{completed!.unallocated.length>0&&<p class="notice">Not allocated: {completed!.unallocated.join(", ")}. Review category limits and your entered credit.</p>}</section>}
</aside>
<div class="planner-main"><section><div class="section-heading"><div><p class="eyebrow">LOOK AHEAD</p><h2>Your semester map</h2></div><span class="saved-indicator"><span></span> Saved to your account</span></div>
<div class="semester-grid">{periods.map(key=>{const [y,s]=key.split("|");const selected=p!.selections.filter(a=>a.year===Number(y)&&a.session===s);return <article class:list={["semester",{current:Number(y)===year&&s===session}]}><header><div><span class="eyebrow">{y}</span><h3>{semesterLabel(s)}</h3></div><span class="small-pill">{selected.reduce((n,c)=>n+c.units,0)} / {p!.load} units</span></header>{selected.map(sel=>{const c=course(sel.code,sel.year),a=assess(p!,rs,sel);return <div class="planned-course"><div class="card-meta"><a href={"/catalogue/"+sel.year+"/course/"+sel.code}>{sel.code}</a><span>{sel.units} units</span></div><h4>{c?.name||sel.code}</h4><p class:list={["course-fit",a.contribution.status==="met"?"positive":"amber"]}>{a.contribution.status==="met"?"✓":"◷"} {a.requirement}</p><details class="course-explanation"><summary>Why this counts & conditions</summary><div>{[["Degree contribution",a.contribution],["Enrolment eligibility",a.eligibility],["Availability",a.availability]].map(([label,check]:any)=><p><strong>{label}</strong><span class:list={["status",check.status]}>{check.status}</span>{check.reasons.join(" ")}</p>)}</div></details><div class="course-actions"><details><summary>Move course</summary><form method="post" action="/api/action" class="form-stack"><input type="hidden" name="action" value="move-selection"/><input type="hidden" name="planId" value={p!.id}/><input type="hidden" name="revision" value={p!.revision}/><input type="hidden" name="selectionId" value={sel.id}/><label for={"move-year-"+sel.id}>Year</label><input id={"move-year-"+sel.id} name="year" type="number" min="2025" max="2035" value={sel.year}/><label for={"move-session-"+sel.id}>Session</label><select id={"move-session-"+sel.id} name="session">{SESSIONS.map(s=><option value={s} selected={sel.session===s}>{semesterLabel(s)}</option>)}</select><button class="button secondary">Save move</button></form></details><form method="post" action="/api/action"><input type="hidden" name="action" value="remove-selection"/><input type="hidden" name="planId" value={p!.id}/><input type="hidden" name="revision" value={p!.revision}/><input type="hidden" name="selectionId" value={sel.id}/><button class="text-button" aria-label={"Remove "+sel.code}>Remove</button></form></div></div>;})}{!selected.length&&<div class="semester-empty"><span>＋</span><p>A little space for<br/>what comes next.</p></div>}<a class="semester-add" href={"/plan?id="+p!.id+"&year="+y+"&session="+encodeURIComponent(s)+"#course-finder"}>＋ Find a course for this semester</a></article>})}</div></section>
{completed!.complete&&<p class="notice success">Reviewed requirements appear satisfied by your reported completed study.</p>}
{!completed!.complete&&projected!.complete&&<p class="notice">Reviewed requirements appear satisfied in projection, conditional on passing all future study and resolving the conditions below.</p>}
<section id="course-finder" class="course-finder"><div class="section-heading"><div><p class="eyebrow">MAKE AN INFORMED CHOICE</p><h2>What could you study next?</h2></div></div><form method="get" class="finder-filters"><input type="hidden" name="id" value={p.id}/><div><label for="teaching-year">Teaching year</label><select id="teaching-year" name="year">{[2025,2026,2027,2028].map(y=><option selected={year===y}>{y}</option>)}</select></div><div><label for="teaching-session">Session</label><select name="session" id="teaching-session">{SESSIONS.map(s=><option value={s} selected={session===s}>{semesterLabel(s)}</option>)}</select></div><div class="grow"><label for="find-course">Find a course</label><input id="find-course" name="q" placeholder="Name or code" value={q}/></div><button class="button secondary">Find →</button></form><p class="fine">Suggested shortlist; search by name or code to explore the whole catalogue. Options use {p.cohort} degree rules and {year} course information. Each choice is rechecked as your plan changes.</p>
<div class="recommendations">{suggestions.map(({c,a})=><article class="recommendation"><div class="recommendation-main"><div class="card-meta"><a href={"/catalogue/"+year+"/course/"+c.code}>{c.code}</a><span>{c.units} units</span></div><h3>{c.name}</h3><p class={a.contribution.status==="met"?"positive":"muted"}>{a.contribution.reasons[0]}</p><div class="assessment-tags"><span class:list={["status",a.eligibility.status]}>{a.eligibility.status==="met"?"Eligibility checked":a.eligibility.status==="conditional"?"Conditional eligibility":a.eligibility.status==="blocked"?"Prerequisite / conflict":"Eligibility needs checking"}</span><span class:list={["status",a.availability.status]}>{a.availability.reasons[0]}</span></div><details><summary>See the reasoning</summary><p>{a.eligibility.reasons.join(" ")}</p><p>{a.contribution.reasons.join(" ")}</p><a href={c.url} target="_blank" rel="noreferrer">Official course details ↗</a></details></div><form method="post" action="/api/action"><input type="hidden" name="action" value="add-selection"/><input type="hidden" name="planId" value={p!.id}/><input type="hidden" name="revision" value={p!.revision}/><input type="hidden" name="code" value={c.code}/><input type="hidden" name="units" value={courseUnits(c)}/><input type="hidden" name="year" value={year}/><input type="hidden" name="session" value={session}/><button class="button add-button" aria-label={"Add "+c.code+" to plan"}>＋ Add</button></form></article>)}</div>
{!suggestions.length&&<p class="empty-state">No matching offerings in this snapshot. You can still add a tentative course below.</p>}
<details class="manual-add"><summary>Add a course directly / plan an unconfirmed offering</summary><form method="post" action="/api/action" class="form-stack"><input type="hidden" name="action" value="add-selection"/><input type="hidden" name="planId" value={p.id}/><input type="hidden" name="revision" value={p.revision}/><div><CoursePicker id="direct-course" year={year<=2027?year:2027}/></div><div><label for="direct-topic">Topic name (repeatable courses)</label><input id="direct-topic" name="topic" maxlength="100"/></div><div class="form-row"><div><label for="direct-units">Units</label><input id="direct-units" name="units" type="number" min="1" max="48" value="6"/></div><div><label for="direct-year">Year</label><input id="direct-year" name="year" type="number" min="2025" max="2035" value={year}/></div></div><div><label for="direct-session">Session</label><select id="direct-session" name="session">{SESSIONS.map(s=><option value={s} selected={session===s}>{semesterLabel(s)}</option>)}</select></div><button class="button secondary">Add tentative choice</button></form></details>
</section>
{(issues.length>0||projected!.issues.length>0)&&<section class="panel issues-panel"><p class="eyebrow">BEFORE YOU ENROL</p><h2>A few things to check.</h2><p>Saving a draft choice does not enrol you or approve an exception.</p><ul>{[...new Set([...projected!.issues,...issues])].map(i=><li>{i}</li>)}</ul></section>}
<details class="panel plan-settings"><summary>Plan settings & comparisons</summary><form method="post" action="/api/action" class="form-stack"><input type="hidden" name="action" value="update-plan"/><input type="hidden" name="planId" value={p.id}/><input type="hidden" name="revision" value={p.revision}/><div><label for="plan-name">Plan name</label><input id="plan-name" name="name" value={p.name} maxlength="80"/></div><div><label for="specialisation">Specialisation · {p.cohort} rules</label><select id="specialisation" name="specialisation"><option value="">Undecided / manual plan</option>{rule?.specialisations.map(s=><option value={s.code} selected={p!.specialisation===s.code}>{s.name}</option>)}</select></div><div class="form-row"><div><label for="target-load">Preferred half-year load</label><select id="target-load" name="load">{[6,12,18,24,30,36].map(n=><option value={n} selected={p!.load===n}>{n} units</option>)}</select></div><div><label for="student-type">Student context</label><select id="student-type" name="studentType"><option value="domestic" selected={p.studentType==="domestic"}>Domestic</option><option value="international" selected={p.studentType==="international"}>International</option></select></div></div><button class="button primary">Save and compare changes</button></form>{p.release!==RELEASE&&<form method="post" action="/api/action"><input type="hidden" name="action" value="refresh-rules"/><input type="hidden" name="planId" value={p.id}/><input type="hidden" name="revision" value={p.revision}/><p class="notice">A newer reviewed catalogue release is available. Rechecking changes this plan's rule version, while keeping your study records.</p><button class="button secondary">Recheck against latest reviewed release</button></form>}<div class="inline-actions"><form method="post" action="/api/action"><input type="hidden" name="action" value="duplicate-plan"/><input type="hidden" name="planId" value={p.id}/><button class="button secondary">Duplicate as an alternative</button></form><form method="post" action="/api/action"><input type="hidden" name="action" value="delete-plan"/><input type="hidden" name="planId" value={p.id}/><input type="hidden" name="revision" value={p.revision}/><button class="text-button danger">Delete this plan</button></form></div><p class="fine">Degree rules remain {p.cohort}. Create another plan to explore a different commencement year; this does not change your actual university program.</p></details>
</div></div>
</>}
</Layout>