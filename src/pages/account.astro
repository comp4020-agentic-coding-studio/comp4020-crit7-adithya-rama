---
import Layout from "../layouts/Layout.astro";
import {currentUser} from "../lib/auth";
const user=currentUser(Astro.cookies),mode=Astro.url.searchParams.get("mode")||"login";
const recovery=Astro.cookies.get("recovery-display")?.value;
if(recovery)Astro.cookies.delete("recovery-display",{path:"/account"});
const isDemo=user?.username.startsWith("demo_");
---
<Layout title="Your account" active="">
<div class="account-layout"><section><p class="eyebrow">PICK UP WHERE YOU LEFT OFF</p><h1>A plan that's<br/><em>yours to keep.</em></h1><p>Save your study record and compare different paths through your degree.</p><div class="note">This is a separate prototype account. Use a new password, not your ANUHub password. University records are entered by you.</div></section><section class="panel account-panel">
{user&&!isDemo?<><h2>Welcome, {user.username}.</h2>{recovery&&<div class="notice success"><h3>Keep your recovery code</h3><p>This is shown once. Store it somewhere private. You can use it once to reset your password.</p><code class="recovery-code">{recovery}</code></div>}{Astro.url.searchParams.has("recovered")&&<p class="notice success">Password reset. Your recovery code has been used and previous sessions have been signed out.</p>}<p>Your plans are saved in this app's database and available when you sign in on another device.</p><a class="button primary" href="/plan">Continue my plan →</a><form method="post" action="/api/action"><input type="hidden" name="action" value="logout"/><button class="text-button">Sign out</button></form></>:<>
<div class="account-tabs"><a aria-current={mode==="login"&&!isDemo?"page":undefined} href="/account">Sign in</a><a aria-current={mode==="register"||isDemo?"page":undefined} href="/account?mode=register">Create account</a></div>
<h2>{isDemo?"Keep your example plan":mode==="register"?"Make yourself at home":mode==="recover"?"Recover your account":"Welcome back."}</h2>
<form method="post" action="/api/action" class="form-stack"><input type="hidden" name="action" value={isDemo||mode==="register"?"register":mode==="recover"?"recover":"login"}/><div><label for="username">Username</label><input id="username" name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9_-]+" placeholder="Choose your own username"/></div>{mode==="recover"&&<div><label for="recoveryCode">Recovery code</label><input id="recoveryCode" name="recoveryCode" required autocomplete="off"/></div>}<div><label for="password">{mode==="recover"?"New password":"Password"}</label><input type="password" id="password" name="password" autocomplete={mode==="login"&&!isDemo?"current-password":"new-password"} minlength="12" maxlength="256" required/><span class="field-help">At least 12 characters.</span></div><button class="button primary">{isDemo?"Save demo to my account":mode==="register"?"Create my account →":mode==="recover"?"Reset password":"Sign in →"}</button></form><a class="text-link" href="/account?mode=recover">Use a recovery code</a>
</>}
</section></div>
</Layout>