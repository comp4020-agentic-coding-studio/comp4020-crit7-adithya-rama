---
import Layout from "../layouts/Layout.astro";
import CoursePicker from "../components/CoursePicker.astro";
import {currentUser} from "../lib/auth";
import {profile,records,listPlans} from "../lib/store";
import {SESSIONS,semesterLabel} from "../lib/types";
import {course} from "../lib/catalogue";
const user=currentUser(Astro.cookies),rs=user?records(user.id):[],pr=user?profile(user.id):null;
const id=Astro.url.searchParams.get("id")||(user?listPlans(user.id)[0]?.id:"")||"";
const edit=rs.find(r=>r.id===Astro.url.searchParams.get("edit"));
---
<Layout title="My study record" active="My study">
<div class="page-heading heading-row"><div><p class="eyebrow">THE FOUNDATION OF YOUR PLAN</p><h1>Your study, so far.</h1><p>What you've completed. What you're taking. What has been approved.</p></div>{user&&<a class="button secondary" href={"/plan?id="+id}>Back to my plan →</a>}</div>
{!user?<div class="empty-state"><h2>Start with your own record.</h2><p>Sign in to save your study, or explore with fictional records.</p><a class="button primary" href="/account">Sign in →</a><form method="post" action="/api/action"><input type="hidden" name="action" value="demo"/><button class="text-button">Try the example student</button></form></div>:<div class="study-grid"><section><div class="section-heading"><h2>Academic history</h2><span class="small-pill">{rs.length} records</span></div><p class="muted">These records are shared across your comparison plans. Correcting a record rechecks all your plans.</p>
{rs.length===0?<div class="empty-state"><h3>Your story starts here.</h3><p>Add a completed course or a credit decision using the form.</p></div>:<div class="record-list">{rs.map(r=><article class="record-row"><div class="record-icon">{r.kind==="passed"?"✓":r.kind.includes("credit")?"+":"○"}</div><div><span class="eyebrow">{r.code} · {r.units} UNITS</span><h3>{course(r.code,r.year)?.name||r.kind.replaceAll("-"," ")}</h3><p>{r.year} · {semesterLabel(r.session)} · {r.kind.replaceAll("-"," ")}</p>{!["passed","failed","withdrawn","in-progress"].includes(r.kind)&&<p class="fine">{r.approval==="approved"?"Approval reported by you":r.approval} · {r.reference} {r.scope&&"· "+r.scope}</p>}</div><a class="text-link" href={"/study?id="+id+"&edit="+r.id+"#record-form"}>Correct record</a></article>)}</div>}
<div class="note"><strong>Credit is different from exemption.</strong><p>Credit carries approved units. An exemption carries zero units—you still need replacement study. Pending decisions do not count.</p><a href="https://www.anu.edu.au/students/program-administration/program-management/get-course-credit-or-exemption" target="_blank" rel="noreferrer">Read ANU's explanation ↗</a></div></section>
<aside class="panel"><p class="eyebrow">{edit?"CORRECT AN ENTRY":"BUILD YOUR STUDY RECORD"}</p><h2>{edit?"Correct my record":"Add a study record"}</h2><form id="record-form" method="post" action="/api/action" class="form-stack"><input type="hidden" name="action" value="record"/><input type="hidden" name="planId" value={id}/><input type="hidden" name="profileRevision" value={pr!.revision}/><input type="hidden" name="recordId" value={edit?.id||""}/>
<div><label for="kind">Record type</label><select name="kind" id="kind">{[["passed","Passed course"],["in-progress","Currently studying"],["failed","Failed course"],["withdrawn","Withdrawn course"],["specified-credit","Specified course credit"],["unspecified-credit","Unspecified credit"],["exemption","Course exemption · zero units"],["substitution","Approved substitution"],["permission","Enrolment permission"],["load-variation","Study-load variation"]].map(([v,l])=><option value={v} selected={edit?.kind===v}>{l}</option>)}</select></div>
<div><CoursePicker value={edit?.code||""}/><span class="field-help">For unspecified credit or load variation, enter CREDIT.</span></div>
<div><label for="topic">Topic name (repeatable advanced topics only)</label><input id="topic" name="topic" maxlength="100" value={edit?.topic||""}/></div>
<div class="form-row"><div><label for="units">Units</label><input id="units" name="units" type="number" min="0" max="96" step="6" value={edit?.units??6} required/></div><div><label for="year">Year</label><input id="year" name="year" type="number" min="2000" max="2035" value={edit?.year||2026} required/></div></div>
<div><label for="session">Teaching session</label><select id="session" name="session">{SESSIONS.map(s=><option value={s} selected={edit?.session===s||!edit&&s==="Second Semester"}>{semesterLabel(s)}</option>)}</select></div>
<details open={!!edit&&!["passed","failed","withdrawn","in-progress"].includes(edit.kind)}><summary>Credit, exemption or approval details</summary><div class="form-stack details-body">
<div><label for="approval">Decision status</label><select id="approval" name="approval">{["approved","pending","withdrawn"].map(v=><option selected={edit?.approval===v}>{v}</option>)}</select></div>
<div><label for="scope">Approved scope</label><select id="scope" name="scope">{[["","Select scope"],["further","Further COMP / ENGN credit"],["elective","University elective credit"],["prerequisite","Prerequisite waiver"],["project","Project-group approval"],["2026 H1","2026 half-year 1 load"],["2026 H2","2026 half-year 2 load"],["2027 H1","2027 half-year 1 load"],["2027 H2","2027 half-year 2 load"]].map(([v,l])=><option value={v} selected={edit?.scope===v}>{l}</option>)}</select></div>
<div><label for="replacement">Replacement course (substitutions)</label><input id="replacement" name="replacement" value={edit?.replacement||""} placeholder="e.g. COMP8020"/><span class="field-help">Enter the original course above and its approved replacement here. Applies only in the entered teaching year.</span></div>
<div><label for="date">Decision date</label><input type="date" id="date" name="date" value={edit?.date||""}/></div><div><label for="reference">Decision reference</label><textarea id="reference" name="reference" maxlength="500" rows="2" placeholder="Brief reference to the decision, without private documents">{edit?.reference||""}</textarea></div><p class="fine">Approvals apply only to this plan’s program, commencement year and the entered teaching period. They are reported by you; this app cannot verify ANU decisions.</p></div></details>
<button class="button primary">{edit?"Save correction":"Add to my study record"} →</button></form>{edit&&<form method="post" action="/api/action"><input type="hidden" name="action" value="remove-record"/><input type="hidden" name="planId" value={id}/><input type="hidden" name="profileRevision" value={pr!.revision}/><input type="hidden" name="recordId" value={edit.id}/><button class="text-button danger">Delete this mistaken record</button></form>}</aside></div>}
</Layout>