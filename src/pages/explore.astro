---
import Layout from "../layouts/Layout.astro";
import {searchCatalogue} from "../lib/catalogue";
const q=Astro.url.searchParams.get("q")||"",year=Number(Astro.url.searchParams.get("year")||2026),kind=Astro.url.searchParams.get("kind")||"course",career=Astro.url.searchParams.get("career")||"",page=Math.max(1,Number(Astro.url.searchParams.get("page"))||1);
const results=searchCatalogue(q,year,kind,career,page);
const next=(p:number)=>{const u=new URL(Astro.url);u.searchParams.set("page",String(p));return u.pathname+u.search;};
---
<Layout title="Explore the catalogue">
<div class="page-heading"><p class="eyebrow">PROGRAMS, COURSES & POSSIBILITIES</p><h1>Find your next step.</h1><p>Explore ANU study options. Make them part of your plan.</p></div>
<form class="search-panel" method="get"><div class="search-main"><label for="q">Search the catalogue</label><div class="search-input"><span aria-hidden="true">⌕</span><input id="q" name="q" value={q} placeholder="Course name, program or code…"/><button class="button primary">Search →</button></div></div><div class="filter-row"><div><label for="kind">I'm looking for</label><select name="kind" id="kind">{["course","program","major","minor","specialisation"].map(k=><option value={k} selected={kind===k}>{k[0].toUpperCase()+k.slice(1)+"s"}</option>)}</select></div><div><label for="year">{kind==="program"?"Commencement year":"Catalogue year"}</label><select name="year" id="year">{[2025,2026,2027].map(y=><option selected={year===y}>{y}</option>)}</select></div><div><label for="career">Study level</label><select name="career" id="career"><option value="">All study levels</option>{["Undergraduate","Postgraduate","Research"].map(c=><option selected={career===c}>{c}</option>)}</select></div><p class="filter-note">Catalogue year changes what you browse.<br/>Your saved degree rules stay the same.</p></div></form>
<div class="section-heading"><h2>{results.total.toLocaleString()} {kind==="course"?"courses":"results"}</h2><span class="muted">ANU catalogue snapshot · September 2026</span></div>
<div class="catalogue-grid">{results.items.map(c=><a class="catalogue-card" href={"/catalogue/"+c.year+"/"+c.kind+"/"+c.code}><div class="card-meta"><span>{c.code}</span><span>{c.kind==="course"?c.units+" units":c.career}</span></div><h3>{c.name}</h3><p>{c.kind==="course"?(c.sessions||"Offerings unconfirmed"):c.kind==="program"?"Explore requirements and start a study plan":c.kind+" · "+c.units+" units"}</p><div class="card-bottom">{c.code==="7706XMCOMP"&&[2025,2026].includes(c.year)?<span class="positive">✓ Degree checking available</span>:<span>{c.year} catalogue</span>}<span aria-hidden="true">↗</span></div></a>)}</div>
{!results.total&&<div class="empty-state"><h2>No matches in this snapshot.</h2><p>Try a shorter name or a different year.</p><a href="https://programsandcourses.anu.edu.au/search" target="_blank" rel="noreferrer">Search official Programs and Courses ↗</a></div>}
<div class="pagination">{page>1&&<a class="button secondary" href={next(page-1)}>← Previous</a>}<span>Page {page} of {Math.max(1,Math.ceil(results.total/24))}</span>{page * 24 < results.total && <a class="button secondary" href={next(page+1)}>Next →</a>}</div>
</Layout>